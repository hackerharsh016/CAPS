# ==============================================================================
# CAPS Windows Print Agent — Environment Configuration Template
# ==============================================================================
# Document: apps/print-agent/.env.example
# Security Policy:
# - NEVER embed Supabase service_role keys or Cloud API server secrets here.
# - The local diagnostic HTTP server MUST bind strictly to 127.0.0.1 (loopback).
#   Binding to 0.0.0.0 is a security violation and will fail startup.
# - Device credentials (device_id, device_token) should ideally be acquired
#   via the one-time pairing flow (POST /api/v1/agent/pair) and stored in DPAPI.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Backend Connectivity
# ------------------------------------------------------------------------------
# Cloud API Base URL (Must end with /api/v1)
# Local: http://127.0.0.1:4000/api/v1
# Staging/Prod: https://api.yourdomain.com/api/v1
CAPS_AGENT_CLOUD_API_URL=http://127.0.0.1:4000/api/v1

# Supabase Realtime WebSocket URL (for instant job notification broadcasts)
# Local: ws://127.0.0.1:54321/realtime/v1/websocket
# Staging/Prod: wss://your-project-id.supabase.co/realtime/v1/websocket
CAPS_AGENT_REALTIME_URL=ws://127.0.0.1:54321/realtime/v1/websocket

# ------------------------------------------------------------------------------
# 2. Local Diagnostics & Tray Loopback Server
# ------------------------------------------------------------------------------
# Must be strictly 127.0.0.1 or localhost (Never 0.0.0.0)
CAPS_AGENT_LOCAL_BIND=127.0.0.1
CAPS_AGENT_LOCAL_PORT=9099

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
CAPS_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. File System & Zero-Retention Security
# ------------------------------------------------------------------------------
# Temp working directory for downloaded spool files (auto-purged after printing)
# Default on Windows: %TEMP%\caps_spool
# CAPS_AGENT_TEMP_DIR=

# Local SQLite state database path (encrypted/protected local store)
# Default on Windows: %LOCALAPPDATA%\caps_agent\state.db
# CAPS_AGENT_DB_PATH=

# Maximum age in seconds before orphaned temp files are hard-purged (Default: 3600)
CAPS_AGENT_CLEANUP_MAX_AGE_SEC=3600

# ------------------------------------------------------------------------------
# 4. Optional Pre-Configured Machine Credentials (or use UI pairing flow)
# ------------------------------------------------------------------------------
# CAPS_SHOP_ID=00000000-0000-0000-0000-000000000001
# CAPS_DEVICE_ID=00000000-0000-0000-0000-000000000002
# CAPS_DEVICE_TOKEN=dev-agent-token-test-001

# ------------------------------------------------------------------------------
# 5. Optional Physical Hardware Testing
# ------------------------------------------------------------------------------
# Set this only when running real printer hardware tests with pywin32
# CAPS_TEST_PRINTER_NAME="HP LaserJet Pro M404n"
