{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@caps/config/tsconfig.next.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@caps/types": ["../../packages/types/src/index.ts"],
      "@caps/validation": ["../../packages/validation/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}
