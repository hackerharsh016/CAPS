# ==============================================================================
# CAPS Customer Web App — Environment Configuration Template
# ==============================================================================
# Document: apps/customer-web/.env.example
# Security Policy:
# - ONLY browser-safe public variables prefixed with NEXT_PUBLIC_ may be added here.
# - SUPABASE_SERVICE_ROLE_KEY is STRICTLY FORBIDDEN in this application.
# ==============================================================================

# Runtime Environment
NODE_ENV=development

# Cloud API Base URL (Used by customer services for pricing, quotes, orders, uploads)
# Local: http://localhost:4000
# Staging/Prod: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase Public Configuration (Authentication, Storage direct upload, Realtime tracking)
# Obtain from: Supabase Project Settings -> API -> Project URL & Project API Keys (anon/public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Razorpay Standard Checkout (Public Key ID only)
# Obtain from: Razorpay Dashboard -> Settings -> API Keys (Key ID begins with rzp_test_ or rzp_live_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
