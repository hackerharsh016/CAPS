# ==============================================================================
# CAPS Shop Owner Dashboard — Environment Configuration Template
# ==============================================================================
# Document: apps/owner-dashboard/.env.example
# Security Policy:
# - ONLY browser-safe public variables prefixed with NEXT_PUBLIC_ may be added here.
# - SUPABASE_SERVICE_ROLE_KEY and Agent Device Tokens are STRICTLY FORBIDDEN.
# ==============================================================================

# Runtime Environment
NODE_ENV=development

# Cloud API Base URL (Used for queue management, printer telemetry, approvals, agent pairing)
# Local: http://localhost:4000
# Staging/Prod: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase Public Configuration (Owner authentication, session cookies, Realtime queue events)
# Obtain from: Supabase Project Settings -> API -> Project URL & Project API Keys (anon/public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
