# ==============================================================================
# CAPS Cloud API Backend — Environment Configuration Template
# ==============================================================================
# Document: apps/cloud-api/.env.example
# Security Policy:
# - This file runs on the Node.js Fastify backend server.
# - Privileged secrets (SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET, etc.)
#   must NEVER be shared with frontend client applications.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 2. Supabase Infrastructure
# ------------------------------------------------------------------------------
# Project URL (Local: http://localhost:54321, Staging: https://your-project.supabase.co)
SUPABASE_URL=http://localhost:54321

# Privileged Service Role Key (Bypasses Row Level Security for admin backend operations)
# Obtain from: Supabase Project Settings -> API -> Project API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Supabase JWT Secret (Used to verify customer and owner Bearer tokens)
# Obtain from: Supabase Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-characters

# Supabase Storage Bucket for Customer Document Uploads & Retention
SUPABASE_STORAGE_BUCKET=customer-documents

# Direct Postgres Database Connection URL (Optional; uses Supabase client if omitted)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway (Test Mode / Production)
# ------------------------------------------------------------------------------
# Obtain from: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Signature Secret (HMAC SHA-256 validation for payment.captured)
# Obtain from: Razorpay Dashboard -> Settings -> Webhooks -> Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. Firebase Cloud Messaging (FCM Push Notifications)
# ------------------------------------------------------------------------------
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=caps-printing-solution
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@caps-printing-solution.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
