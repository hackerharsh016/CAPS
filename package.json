{
  "name": "caps",
  "version": "0.1.0",
  "private": true,
  "description": "CAPS — Cloud Automated Printing Solution with User-Side Configuration",
  "packageManager": "pnpm@10.26.2",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "vitest run tests/e2e",
    "test:virtual-printer": "tsx scripts/run-virtual-printer-scenario.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
