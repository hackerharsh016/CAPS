# ==============================================================================
# CAPS (Cloud Automated Printing Solution) — Root Environment Template
# ==============================================================================
# Document: .env.example
# Security Policy: NEVER commit real credentials or secrets to source control.
#
# Monorepo Loading Behavior:
# - apps/customer-web: Loads apps/customer-web/.env.local (Next.js convention)
# - apps/owner-dashboard: Loads apps/owner-dashboard/.env.local (Next.js convention)
# - apps/cloud-api: Loads apps/cloud-api/.env via Node.js native env loader
# - apps/print-agent: Loads apps/print-agent/.env via Python config loader
#
# Root .env is used for workspace-level scripts, local orchestrators, and default
# fallbacks. Application-specific .env/.env.local files take precedence.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Runtime Mode
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Shared Public Base URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 3. Public Payment Integration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# ------------------------------------------------------------------------------
# 4. Backend Cloud API (Server-Only Secrets — NEVER expose to browser bundles)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-characters
SUPABASE_STORAGE_BUCKET=customer-documents
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. Push Notifications — Firebase Cloud Messaging (Server-Side Only)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=caps-printing-solution
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@caps-printing-solution.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. Windows Desktop Print Agent
# ------------------------------------------------------------------------------
CAPS_AGENT_CLOUD_API_URL=http://127.0.0.1:4000/api/v1
CAPS_AGENT_REALTIME_URL=ws://127.0.0.1:54321/realtime/v1/websocket
CAPS_AGENT_LOCAL_BIND=127.0.0.1
CAPS_AGENT_LOCAL_PORT=9099
CAPS_LOG_LEVEL=INFO
