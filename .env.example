# ==============================================================================
# CAPS (Cloud Automated Printing Solution) — Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure (Managed PostgreSQL, Auth, Private Storage, WSS)
# ------------------------------------------------------------------------------
# Browser-safe public URL and anon key (used by apps/customer-web, apps/owner-dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token

# Server-only Service Role Key (Used strictly by apps/cloud-api — NEVER expose to web or agent)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Storage Bucket Name for Private Document Pipeline
SUPABASE_STORAGE_BUCKET=caps-private-documents

# ------------------------------------------------------------------------------
# 2. Cloud API Backend Service (apps/cloud-api)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Public URL for the Cloud API
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 3. Payment Gateway — Razorpay
# ------------------------------------------------------------------------------
# Public Key ID (used for checkout initiation on web)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Server-only Secret and Webhook Signature (Cloud API only)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. Push Notifications — Firebase Cloud Messaging (FCM)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=caps-printing-solution
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@caps-printing-solution.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. Desktop Print Agent Configuration (apps/print-agent)
# ------------------------------------------------------------------------------
# Outbound Cloud API endpoint
CAPS_AGENT_CLOUD_API_URL=http://localhost:4000/api/v1
# Realtime WebSocket endpoint
CAPS_AGENT_REALTIME_URL=wss://your-project-id.supabase.co/realtime/v1/websocket

# Local loopback diagnostics (Binds STRICTLY to 127.0.0.1)
CAPS_AGENT_LOCAL_PORT=9099
CAPS_AGENT_LOCAL_BIND=127.0.0.1
