{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@caps/config/tsconfig.node.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests/**/*"]
}
