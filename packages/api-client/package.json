{
  "name": "@caps/api-client",
  "version": "0.1.0",
  "description": "CAPS typed frontend and cross-service HTTP API client with auth propagation, error taxonomy, and idempotent retry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@caps/types": "workspace:*"
  },
  "devDependencies": {
    "@caps/config": "workspace:*",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
