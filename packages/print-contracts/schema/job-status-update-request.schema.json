{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caps.internal/schemas/job-status-update-request.schema.json",
  "title": "CAPS Job Status Update Request Schema",
  "type": "object",
  "required": [
    "contract_version",
    "job_id",
    "attempt_id",
    "lease_token",
    "status",
    "pages_printed",
    "total_pages",
    "timestamp"
  ],
  "properties": {
    "contract_version": { "$ref": "common.schema.json#/$defs/SemVer" },
    "job_id": { "$ref": "common.schema.json#/$defs/UUID" },
    "attempt_id": { "type": "string", "minLength": 1 },
    "lease_token": { "type": "string", "minLength": 16 },
    "status": { "$ref": "common.schema.json#/$defs/JobAgentStatus" },
    "spooler_job_id": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "pages_printed": {
      "type": "integer",
      "minimum": 0
    },
    "total_pages": {
      "type": "integer",
      "minimum": 1
    },
    "error_code": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/ErrorCode" }]
    },
    "error_message": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "timestamp": { "$ref": "common.schema.json#/$defs/ISO8601" }
  },
  "additionalProperties": false
}
