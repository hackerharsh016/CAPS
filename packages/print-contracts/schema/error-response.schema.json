{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caps.internal/schemas/error-response.schema.json",
  "title": "CAPS Standard API Error Response Schema",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message", "request_id"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/ErrorCode" },
        "message": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
