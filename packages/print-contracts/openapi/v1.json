{
  "openapi": "3.1.0",
  "info": {
    "title": "CAPS Desktop Agent API",
    "version": "1.0.0",
    "description": "CAPS cross-language contracts for Windows Desktop Print Agent communication with Cloud API."
  },
  "servers": [
    {
      "url": "https://api.caps.internal/api/v1",
      "description": "Production Cloud API v1"
    },
    {
      "url": "http://127.0.0.1:4000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "AgentBearerAuth": []
    }
  ],
  "paths": {
    "/agent/pair": {
      "post": {
        "summary": "Agent Device Pairing Handshake",
        "description": "Public onboarding: Desktop agent exchanges single-use pairing code for per-device credentials.",
        "operationId": "pairDevice",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairAgentDeviceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device enrolled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairAgentDeviceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pairing code not found or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Pairing code already consumed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/heartbeat": {
      "post": {
        "summary": "Agent Heartbeat & Capabilities",
        "description": "Desktop agent periodically reports liveness and attached hardware printer capabilities.",
        "operationId": "reportHeartbeat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentCapabilities"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Heartbeat and capabilities acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["contract_version", "acknowledged", "server_time"],
                  "properties": {
                    "contract_version": { "type": "string", "example": "1.0.0" },
                    "acknowledged": { "type": "boolean", "example": true },
                    "server_time": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized agent device token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/jobs/claim": {
      "post": {
        "summary": "Claim Next Authorized Job",
        "description": "Atomically acquires a temporary lease for the next approved print job matching shop and printer capabilities.",
        "operationId": "claimJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobClaimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job claim evaluation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobClaimResponse"
                }
              }
            }
          },
          "204": {
            "description": "No authorized jobs available for claim"
          },
          "401": {
            "description": "Unauthorized agent device token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - agent does not belong to the requested shop",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Capabilities mismatch or malformed claim request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/jobs/{job_id}/status": {
      "post": {
        "summary": "Update Claimed Job Status",
        "description": "Idempotently reports job execution progress, spooler ID, physical page counter, or failures.",
        "operationId": "updateJobStatus",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "description": "UUID of the claimed print job",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique idempotent execution request key",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobStatusUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status update processed and acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusUpdateResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized agent device token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - lease expired or attempt ID mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid status transition or malformed payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/jobs/status": {
      "post": {
        "summary": "Update Claimed Job Status (Body Job ID)",
        "description": "Idempotently reports job execution progress, spooler ID, physical page counter, or failures where job_id is provided in the request body.",
        "operationId": "updateJobStatusBody",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Unique idempotent execution request key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobStatusUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status update processed and acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusUpdateResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized agent device token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - lease expired or attempt ID mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid status transition or malformed payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AgentBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "CAPS-Agent-Token",
        "description": "Hardware-registered print agent device token"
      }
    },
    "schemas": {
      "PaperSize": {
        "type": "string",
        "enum": ["a4", "a3", "legal", "letter"]
      },
      "ColorMode": {
        "type": "string",
        "enum": ["bw", "color"]
      },
      "DuplexMode": {
        "type": "string",
        "enum": ["simplex", "duplex_long", "duplex_short"]
      },
      "Orientation": {
        "type": "string",
        "enum": ["portrait", "landscape"]
      },
      "BindingType": {
        "type": "string",
        "enum": ["none", "corner_staple", "side_staple", "comb", "spiral", "hardbound"]
      },
      "PrinterStatus": {
        "type": "string",
        "enum": ["online", "offline", "busy", "error"]
      },
      "JobAgentStatus": {
        "type": "string",
        "enum": ["CLAIMED", "DOWNLOADING", "RENDERING", "PRINTING", "COMPLETED", "FAILED"]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "LEASE_EXPIRED",
          "JOB_ALREADY_CLAIMED",
          "CAPABILITIES_MISMATCH",
          "INVALID_PAYLOAD",
          "IDEMPOTENCY_CONFLICT",
          "PRINTER_OFFLINE",
          "PAPER_JAM",
          "SPOOLER_ERROR",
          "DOWNLOAD_FAILED",
          "CHECKSUM_MISMATCH",
          "UNKNOWN_OUTCOME",
          "INTERNAL_ERROR"
        ]
      },
      "PrintSettings": {
        "type": "object",
        "required": [
          "paper_size",
          "color_mode",
          "duplex",
          "orientation",
          "copies",
          "page_range",
          "binding"
        ],
        "properties": {
          "paper_size": { "$ref": "#/components/schemas/PaperSize" },
          "color_mode": { "$ref": "#/components/schemas/ColorMode" },
          "duplex": { "$ref": "#/components/schemas/DuplexMode" },
          "orientation": { "$ref": "#/components/schemas/Orientation" },
          "copies": { "type": "integer", "minimum": 1, "maximum": 100 },
          "page_range": { "type": "string", "example": "1-5, 8" },
          "binding": { "$ref": "#/components/schemas/BindingType" }
        },
        "additionalProperties": false
      },
      "AgentCapabilities": {
        "type": "object",
        "required": [
          "contract_version",
          "agent_device_id",
          "agent_version",
          "shop_id",
          "printers",
          "reported_at"
        ],
        "properties": {
          "contract_version": { "type": "string", "example": "1.0.0" },
          "agent_device_id": { "type": "string", "example": "agent-pc-01" },
          "agent_version": { "type": "string", "example": "0.1.0" },
          "shop_id": { "type": "string", "format": "uuid" },
          "printers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "printer_id",
                "name",
                "is_default",
                "status",
                "supported_paper_sizes",
                "supported_color_modes",
                "supported_duplex"
              ],
              "properties": {
                "printer_id": { "type": "string", "example": "canon-ir2006" },
                "name": { "type": "string", "example": "Canon imageRUNNER 2006" },
                "is_default": { "type": "boolean" },
                "status": { "$ref": "#/components/schemas/PrinterStatus" },
                "supported_paper_sizes": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/PaperSize" }
                },
                "supported_color_modes": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ColorMode" }
                },
                "supported_duplex": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DuplexMode" }
                },
                "last_seen_at": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            }
          },
          "reported_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "JobClaimRequest": {
        "type": "object",
        "required": ["contract_version", "agent_device_id", "shop_id", "timestamp"],
        "properties": {
          "contract_version": { "type": "string", "example": "1.0.0" },
          "agent_device_id": { "type": "string", "example": "agent-pc-01" },
          "shop_id": { "type": "string", "format": "uuid" },
          "requested_printer_id": { "type": "string" },
          "lease_duration_seconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 600,
            "default": 120
          },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "JobClaimResponse": {
        "type": "object",
        "required": ["contract_version", "claimed"],
        "properties": {
          "contract_version": { "type": "string", "example": "1.0.0" },
          "claimed": { "type": "boolean" },
          "job": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": [
                  "job_id",
                  "attempt_id",
                  "lease_token",
                  "lease_expires_at",
                  "shop_id",
                  "printer_id",
                  "download_url",
                  "checksum_sha256",
                  "content_type",
                  "file_size_bytes",
                  "settings",
                  "created_at"
                ],
                "properties": {
                  "job_id": { "type": "string", "format": "uuid" },
                  "attempt_id": { "type": "string", "example": "attempt-7a8b9c" },
                  "lease_token": { "type": "string", "minLength": 16 },
                  "lease_expires_at": { "type": "string", "format": "date-time" },
                  "shop_id": { "type": "string", "format": "uuid" },
                  "printer_id": { "type": "string", "example": "canon-ir2006" },
                  "download_url": { "type": "string", "format": "uri" },
                  "checksum_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
                  "content_type": { "type": "string", "enum": ["application/pdf"] },
                  "file_size_bytes": { "type": "integer", "minimum": 1 },
                  "settings": { "$ref": "#/components/schemas/PrintSettings" },
                  "created_at": { "type": "string", "format": "date-time" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "JobStatusUpdateRequest": {
        "type": "object",
        "required": [
          "contract_version",
          "job_id",
          "attempt_id",
          "lease_token",
          "status",
          "pages_printed",
          "total_pages",
          "timestamp"
        ],
        "properties": {
          "contract_version": { "type": "string", "example": "1.0.0" },
          "job_id": { "type": "string", "format": "uuid" },
          "attempt_id": { "type": "string", "example": "attempt-7a8b9c" },
          "lease_token": { "type": "string", "minLength": 16 },
          "status": { "$ref": "#/components/schemas/JobAgentStatus" },
          "spooler_job_id": { "type": ["integer", "null"], "minimum": 1 },
          "pages_printed": { "type": "integer", "minimum": 0 },
          "total_pages": { "type": "integer", "minimum": 1 },
          "error_code": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/ErrorCode" }]
          },
          "error_message": { "type": ["string", "null"], "maxLength": 1000 },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "JobStatusUpdateResponse": {
        "type": "object",
        "required": ["contract_version", "success", "job_id", "status", "acknowledged_at"],
        "properties": {
          "contract_version": { "type": "string", "example": "1.0.0" },
          "success": { "type": "boolean" },
          "job_id": { "type": "string", "format": "uuid" },
          "status": { "$ref": "#/components/schemas/JobAgentStatus" },
          "acknowledged_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "PairAgentDeviceRequest": {
        "type": "object",
        "required": ["pairing_code"],
        "properties": {
          "pairing_code": { "type": "string", "example": "123456" },
          "device_fingerprint": { "type": "string", "example": "fp-desk-01" },
          "fingerprint": { "type": "string", "example": "fp-desk-01" },
          "device_name": { "type": "string", "example": "Front Desk Print Station" },
          "hostname": { "type": "string", "example": "DESKTOP-PRINT-01" },
          "os_version": { "type": "string", "example": "Windows 11 Pro 23H2" },
          "agent_version": { "type": "string", "example": "0.1.0" }
        },
        "anyOf": [
          { "required": ["device_fingerprint", "device_name"] },
          { "required": ["hostname"] }
        ]
      },
      "PairAgentDeviceResponse": {
        "type": "object",
        "required": ["success", "device_id", "shop_id", "device_secret"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "device_id": { "type": "string", "example": "dev-01" },
          "shop_id": { "type": "string", "format": "uuid" },
          "device_secret": { "type": "string", "example": "caps_agent_sec_998877665544332211" },
          "device_token": { "type": "string", "example": "caps_agent_sec_998877665544332211" },
          "agent_version": { "type": "string", "example": "0.1.0" }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "request_id"],
            "properties": {
              "code": { "$ref": "#/components/schemas/ErrorCode" },
              "message": { "type": "string" },
              "request_id": { "type": "string" },
              "details": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
